From c5cfb28673a6b5e6c04452403afa1a8bec605015 Mon Sep 17 00:00:00 2001
From: gnd <gnd@local>
Date: Fri, 13 Nov 2026 11:10:23 +0800
Subject: [PATCH] simu: bridge external module S.Port to the host
 (simuExtModuleTxRead/RxPush)

---
 radio/src/targets/simu/module_drivers.cpp | 133 +++++++++++++++++++++-
 radio/src/targets/simu/simulib.h          |   5 +
 2 files changed, 135 insertions(+), 3 deletions(-)

diff --git a/radio/src/targets/simu/module_drivers.cpp b/radio/src/targets/simu/module_drivers.cpp
index 69dd010..54fc584 100644
--- a/radio/src/targets/simu/module_drivers.cpp
+++ b/radio/src/targets/simu/module_drivers.cpp
@@ -113,6 +113,133 @@ const etx_serial_driver_t _fakeSerialDriver = {
 };
 
 #if defined(HARDWARE_EXTERNAL_MODULE)
+// External module S.Port for the host (gnd-android-full): bytes EdgeTX sends
+// (e.g. CRSF channel frames) are queued for simuExtModuleTxRead(), and bytes
+// from simuExtModuleRxPush() are handed to the protocol's frame parser.
+#include <mutex>
+#include "simulib.h"
+#include "telemetry/telemetry.h"
+#include "pulses/pulses.h"
+
+namespace {
+struct ExtSport {
+  std::mutex mu;
+  bool used = false;
+  uint8_t tx[1024];
+  uint32_t tx_len = 0;
+  uint8_t rx[TELEMETRY_RX_PACKET_SIZE];
+  uint32_t rx_len = 0;
+};
+ExtSport _ext_sport;
+}  // namespace
+
+static void* ext_init(void* ctx, const etx_serial_init*)
+{
+  std::lock_guard<std::mutex> lock(_ext_sport.mu);
+  if (_ext_sport.used) return nullptr;
+  _ext_sport.used = true;
+  _ext_sport.tx_len = 0;
+  _ext_sport.rx_len = 0;
+  return &_ext_sport;
+}
+
+static void ext_deinit(void*)
+{
+  std::lock_guard<std::mutex> lock(_ext_sport.mu);
+  _ext_sport.used = false;
+  _ext_sport.tx_len = 0;
+  _ext_sport.rx_len = 0;
+}
+
+static void ext_sendBuffer(void*, const uint8_t* data, uint32_t len)
+{
+  std::lock_guard<std::mutex> lock(_ext_sport.mu);
+  if (len > sizeof(_ext_sport.tx)) {
+    data += len - sizeof(_ext_sport.tx);
+    len = sizeof(_ext_sport.tx);
+  }
+  if (_ext_sport.tx_len + len > sizeof(_ext_sport.tx)) {
+    // Host fell behind: keep the newest bytes.
+    uint32_t drop = _ext_sport.tx_len + len - sizeof(_ext_sport.tx);
+    memmove(_ext_sport.tx, _ext_sport.tx + drop, _ext_sport.tx_len - drop);
+    _ext_sport.tx_len -= drop;
+  }
+  memcpy(_ext_sport.tx + _ext_sport.tx_len, data, len);
+  _ext_sport.tx_len += len;
+}
+
+static void ext_sendByte(void* ctx, uint8_t b) { ext_sendBuffer(ctx, &b, 1); }
+
+static int ext_getBufferedBytes(void*)
+{
+  std::lock_guard<std::mutex> lock(_ext_sport.mu);
+  return (int)_ext_sport.rx_len;
+}
+
+static int ext_copyRxBuffer(void*, uint8_t* buf, uint32_t len)
+{
+  std::lock_guard<std::mutex> lock(_ext_sport.mu);
+  uint32_t n = _ext_sport.rx_len < len ? _ext_sport.rx_len : len;
+  memcpy(buf, _ext_sport.rx, n);
+  memmove(_ext_sport.rx, _ext_sport.rx + n, _ext_sport.rx_len - n);
+  _ext_sport.rx_len -= n;
+  return (int)n;
+}
+
+static void ext_clearRxBuffer(void*)
+{
+  std::lock_guard<std::mutex> lock(_ext_sport.mu);
+  _ext_sport.rx_len = 0;
+}
+
+static const etx_serial_driver_t _extSportDriver = {
+    .init = ext_init,
+    .deinit = ext_deinit,
+    .sendByte = ext_sendByte,
+    .sendBuffer = ext_sendBuffer,
+    .txCompleted = txCompleted,
+    .waitForTxCompleted = waitForTxCompleted,
+    .enableRx = nullptr,
+    .getByte = getByte,
+    .getLastByte = nullptr,
+    .getBufferedBytes = ext_getBufferedBytes,
+    .copyRxBuffer = ext_copyRxBuffer,
+    .clearRxBuffer = ext_clearRxBuffer,
+    .getBaudrate = nullptr,
+    .setBaudrate = nullptr,
+    .setPolarity = nullptr,
+    .setHWOption = nullptr,
+    .setReceiveCb = nullptr,
+    .setIdleCb = nullptr,
+    .setBaudrateCb = nullptr,
+};
+
+uint32_t simuExtModuleTxRead(uint8_t* buf, uint32_t max)
+{
+  std::lock_guard<std::mutex> lock(_ext_sport.mu);
+  uint32_t n = _ext_sport.tx_len < max ? _ext_sport.tx_len : max;
+  memcpy(buf, _ext_sport.tx, n);
+  memmove(_ext_sport.tx, _ext_sport.tx + n, _ext_sport.tx_len - n);
+  _ext_sport.tx_len -= n;
+  return n;
+}
+
+bool simuExtModuleRxPush(const uint8_t* data, uint32_t len)
+{
+  {
+    std::lock_guard<std::mutex> lock(_ext_sport.mu);
+    if (!_ext_sport.used) return false;
+    if (_ext_sport.rx_len + len > sizeof(_ext_sport.rx)) return false;
+    memcpy(_ext_sport.rx + _ext_sport.rx_len, data, len);
+    _ext_sport.rx_len += len;
+  }
+  auto mod = pulsesGetModuleDriver(EXTERNAL_MODULE);
+  if (!mod || !mod->drv) return false;
+  // Runs the protocol's processFrame on the timer task, like the UART IRQ.
+  telemetryFrameTrigger_ISR(EXTERNAL_MODULE, mod->drv);
+  return true;
+}
+
 static void* module_timer_init(void* hw_def, const etx_timer_config_t* cfg)
 { return (void*)1; }
 
@@ -227,13 +354,13 @@ const etx_module_port_t _external_ports[] = {
     .hw_def = nullptr,
   },
 #endif
-  // TX/RX half-duplex on S.PORT
+  // TX/RX half-duplex on S.PORT, bridged to the host
   {
     .port = ETX_MOD_PORT_SPORT,
     .type = ETX_MOD_TYPE_SERIAL,
     .dir_flags = ETX_MOD_DIR_TX | ETX_MOD_DIR_RX,
-    .drv = { .serial = &_fakeSerialDriver },
-    .hw_def = &_sport_used,
+    .drv = { .serial = &_extSportDriver },
+    .hw_def = &_ext_sport,
   },
 #if defined(TELEMETRY_TIMER)
   // RX soft-serial sampled bit-by-bit via timer IRQ on S.PORT
diff --git a/radio/src/targets/simu/simulib.h b/radio/src/targets/simu/simulib.h
index 2e3cb99..bb3c270 100644
--- a/radio/src/targets/simu/simulib.h
+++ b/radio/src/targets/simu/simulib.h
@@ -57,6 +57,11 @@ void WASM_EXPORT(simuFatfsSetPaths)(const char * sdPath, const char * settingsPa
 // Input: keys use Board::Keys enum, switches use Board switch indices,
 // trims use Board::TrimSwitches enum (momentary press, not value).
 void WASM_EXPORT(simuSetKey)(uint8_t key, bool state);
+
+// External module serial (S.Port) bridge: drain what EdgeTX sent (e.g. CRSF
+// channel frames) and push received bytes (e.g. CRSF telemetry) to its parser.
+uint32_t WASM_EXPORT(simuExtModuleTxRead)(uint8_t* buf, uint32_t max);
+bool WASM_EXPORT(simuExtModuleRxPush)(const uint8_t* data, uint32_t len);
 void WASM_EXPORT(simuSetTrim)(uint8_t trim, bool state);
 void WASM_EXPORT(simuSetSwitch)(uint8_t swtch, int8_t state);
 
